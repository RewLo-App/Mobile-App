{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug API Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm.cmd",
            "runtimeArgs": [
                "--filter",
                "@workspace/api-server",
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        }
    ]
}