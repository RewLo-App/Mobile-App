# Server-only Brale testnet credentials. Never use these in EXPO_PUBLIC_* variables.
BRALE_CLIENT_ID=replace-with-server-client-id
BRALE_CLIENT_SECRET=replace-with-server-client-secret
BRALE_ACCOUNT_ID=replace-with-platform-account-id
BRALE_API_URL=https://api.brale.xyz
BRALE_AUTH_URL=https://auth.brale.xyz/oauth2/token
BRALE_NETWORK=base_sepolia
# Maximum time for one Brale authentication or API call (1,000-30,000 ms).
# A timeout is returned to the client as a provider error.
BRALE_REQUEST_TIMEOUT_MS=8000
# Local-only: permits signup while a managed Brale wallet is not configured.
# Never enable this in production.
ALLOW_UNPROVISIONED_REGISTRATION=false
# Required for per-user managed accounts. This JSON is supplied only by the
# compliance-approved backend workflow; never collect or fabricate KYC/KYB
# values in the public registration request.
# BRALE_MANAGED_ACCOUNT_TEMPLATE_JSON={"business_name":"...","ein":"...","address":{},"phone_number":"...","website":"...","beneficial_owners":[],"business_controller":{},"tos_attestation":{}}
AUTH_ACCESS_TOKEN_SECRET=generate-a-long-random-server-only-secret
AUTH_JWT_ISSUER=rewlo-api
AUTH_JWT_AUDIENCE=rewlo-mobile
# Optional production password-reset email sender and web-app reset URL.
# Without RESET_EMAIL_FROM, reset URLs are logged only outside production.
RESET_EMAIL_FROM=RewLo <security@example.com>
PASSWORD_RESET_URL=https://app.example.com/reset-password

# Defaults used by BraleService when a call does not override them.
BRALE_STABLECOIN=SBC
EXPO_PUBLIC_API_URL=http://localhost:3001
PORT=3001
# Optional public base URL advertised by Swagger. Defaults to the request
# origin plus /api/v1, so local and deployed environments work without it.
# OPENAPI_SERVER_URL=https://api.example.com/api/v1
